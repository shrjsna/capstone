# AEGIS Industrial Safety System — Environment Configuration
# Copy this file to .env and customize for your deployment environment.

# Server Network Binding
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000

# Authentication (Change this to a strong secret in production!)
AEGIS_API_KEY=aegis-secret-key-2026
AEGIS_AUTH_ENABLED=true

# Explicit CORS Allowed Origins (comma-separated, no wildcards in production)
# Example: CORS_ALLOWED_ORIGINS=http://localhost:8000,http://192.168.1.100:8000
CORS_ALLOWED_ORIGINS=

# Data Retention & Automated Cleanup Policy
# Delete video clips and prune event database older than RETENTION_DAYS
AEGIS_RETENTION_DAYS=7
AEGIS_MAX_EVENTS=5000
AEGIS_CLIPS_DIR=clips

# Live Stream Resource Safeguards
AEGIS_MAX_MJPEG_CLIENTS=10
